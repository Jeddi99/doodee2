DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173
# Only needed to override the default, which is https:// for each DJANGO_ALLOWED_HOSTS entry.
# Behind the reverse proxy the admin login POST is checked against this; get it wrong and the
# form answers "CSRF verification failed" while every API route keeps working, because those
# authenticate with a bearer token and run no CSRF check at all.
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/doodee
# Production: DATABASE_URL is the Supabase session pooler URI; migrations use the direct URI.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
FIREBASE_PROJECT_ID=replace-me
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SECRET_KEY=replace-me
SUPABASE_STORAGE_BUCKET=face-scans
# Set to false for any public medical launch until clinician, privacy and validation review
# are complete (see data.md).
SIMULATION_ENABLED=true
# Promo codes hand out paid entitlement free and can be redeemed repeatedly, and a grant already
# issued cannot be revoked. Default is now false — turn it on only for a demo you control.
REDEEM_CODES_ENABLED=false
# DOODEE Chat. Without a key the chat endpoints answer 503 and nothing is billed.
# Gemini 2.5 Flash is the production default.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ขัดผิวภาพจำลองด้วยโมเดลนอก (flux refine) — ปิดไว้เป็นค่าเริ่มต้น
# ส่ง "ครอปรอบจุดที่แก้" ของภาพใบหน้าผู้ใช้ไปยัง BFL Flux หรือ Vercel AI Gateway และเสียเงินต่อครั้ง
# ครอปเปลือกตาหรือกรามก็ยังเป็นภาพของคน — การยินยอมให้จำลองไม่ใช่การยินยอมให้ส่งออกไปข้างนอก
# ไม่มีคีย์ = ไม่ทำงานอยู่แล้ว แต่นั่นเป็นอุบัติเหตุ ไม่ใช่การตัดสินใจ สวิตช์นี้คือการตัดสินใจ
SIMULATION_POLISH_ENABLED=false

# วิเคราะห์ผิวด้วยภาพ (skin vision) — ปิดไว้เป็นค่าเริ่มต้น
# นี่คือที่เดียวในระบบที่ "ภาพใบหน้าจริง" ของผู้ใช้ถูกส่งออกไปนอกระบบ ต่างจากแชทที่ส่งแค่ตัวเลข 12 ค่า
# Gemini ชั้นฟรีอาจนำสิ่งที่ส่งเข้าไปใช้ปรับปรุงโมเดล ซึ่งกับฟีเจอร์นี้แปลว่า "ใบหน้าผู้ใช้"
# อย่าเปิดจนกว่าโปรเจกต์จะอยู่บนชั้นที่เสียเงินและไม่นำข้อมูลไปเทรน
SKIN_VISION_ENABLED=false

# ผู้ให้บริการอื่นที่เข้ากันได้กับ OpenAI (Groq / OpenRouter / Ollama) — มีไว้ทดสอบโดยไม่เสียเงิน
# เลือกผู้ให้บริการ โมเดล และที่อยู่ API ได้ที่ /admin → ตั้งค่า AI แชท (ไม่ต้องแก้ไฟล์นี้)
#   Groq       https://api.groq.com/openai/v1      คีย์ขึ้นต้น gsk_  ขอฟรีที่ console.groq.com
#   OpenRouter https://openrouter.ai/api/v1        คีย์ขึ้นต้น sk-or-
#   Ollama     http://host.docker.internal:11434/v1  ไม่ต้องใส่คีย์ ปล่อยว่างไว้
CHAT_API_KEY=
CHAT_ENABLED=true
# โควตาแชทและเพดานรายชั่วโมงย้ายไปอยู่ในหน้า admin แล้ว
#   โควตาต่อแผน  → แผน (Plan)
#   เพดาน/ชั่วโมง, รางวัลชวนเพื่อน, ขั้นต่ำการถอน, วันผ่อนผัน → ตั้งค่าระบบสมาชิกและชวนเพื่อน
# แก้ในนั้นได้เลย ไม่ต้อง deploy ใหม่

# คีย์เข้ารหัสเลขบัญชีธนาคารของผู้ใช้ ต้องตั้งก่อนถึงจะบันทึกบัญชีรับเงินได้
# สร้างด้วย: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYOUT_ENCRYPTION_KEY=
# Sample scans, so chat, the score card and the paid gates can be used without a camera.
# Defaults to DJANGO_DEBUG. Never true on a deployment real users can reach: it lets anyone
# mint a completed scan they never took, and every count in the admin overview would include it.
DEMO_SCANS_ENABLED=false
# Used only by the admin cost report. Keep in step with the model in chat.py.
CHAT_PRICE_IN_USD_PER_MTOK=0.20
CHAT_PRICE_CACHED_IN_USD_PER_MTOK=0.02
CHAT_PRICE_OUT_USD_PER_MTOK=1.20
USD_THB_RATE=35
LLM_BUDGET_THB_PER_MONTH=570
LLM_BUDGET_ADMISSION_RATIO=0.90
CHAT_GLOBAL_CONCURRENCY=30
HEAVY_QUEUE_MAX=100
HEAVY_QUEUE_MAX_AGE_SECONDS=600
# อีเมลแจ้งเตือน — เตือนต่ออายุ และข้อความบอกลูกค้าว่ายืนยันการชำระเงินแล้ว
# ว่างไว้ = Django ใช้ console backend ซึ่ง "ส่งสำเร็จ" ทุกครั้งโดยพิมพ์ลง stdout เฉย ๆ
# บน production ที่ DJANGO_DEBUG=false ระบบจะไม่ยอมบูตถ้าไม่ได้ตั้ง เพราะการแจ้งเตือนที่
# ไม่มีใครได้รับแต่ระบบบอกว่าส่งแล้ว แย่กว่าการไม่มีระบบแจ้งเตือนเลย
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DOODEE <no-reply@doodee.app>

# Error reporting. Leave blank to disable — nothing is sent without a DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_API_URL=http://localhost:8001/api/v1
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_STORAGE_BUCKET=replace-me
VITE_FIREBASE_APP_ID=replace-me
EXPO_PUBLIC_API_URL=http://localhost:8001/api/v1
EXPO_PUBLIC_FIREBASE_API_KEY=replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace-me
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace-me
EXPO_PUBLIC_FIREBASE_APP_ID=replace-me
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace-me
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace-me
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-me

# Opn Payments (Omise). Public key is client-side by design and safe to ship in the bundle.
# The SECRET key must never appear here in a committed file — .env is gitignored; .env.example
# is not, so it stays blank in the example and is filled in only in your own .env.
VITE_OMISE_PUBLIC_KEY=pkey_test_replace-me
OMISE_SECRET_KEY=
# Signs the webhook. Copy from dashboard.omise.co → Webhooks. Without it the webhook endpoint
# refuses every request rather than trusting unsigned ones.
OMISE_WEBHOOK_SECRET=
