.env
firebase-service-account.json
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
node_modules/
dist/
.expo/
coverage/
*.sqlite3
.claude/

# Firebase admin service-account keys — never commit, whatever the filename.
*firebase-adminsdk*.json
apps/web/dist/

# collectstatic output — rebuilt in the image, never committed.
backend/staticfiles/
staticfiles/

# celery beat's own state, written into ./backend because compose bind-mounts it. Appears the
# first time `docker compose up` runs the beat container, and is not ours to commit.
backend/celerybeat-schedule

# Test photographs for the scan page's upload path. Derived from an asset already in the tree by
# backend/datamock/make_fixtures.py, so the recipe is version-controlled and the megabytes are
# not. Regenerate with the command in backend/datamock/README.md.
backend/datamock/*
!backend/datamock/make_fixtures.py
!backend/datamock/README.md

# MediaPipe WASM runtime, copied out of node_modules by
# apps/web/scripts/sync-mediapipe-wasm.mjs on predev/prebuild. Derived, not authored.
apps/web/public/wasm/
