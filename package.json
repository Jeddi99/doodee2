{
  "name": "doodee-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "doctor": "docker compose exec api python manage.py check_services",
    "dev:web": "npm run dev --workspace @doodee/web",
    "build:web": "npm run build --workspace @doodee/web",
    "test:web": "npm test --workspace @doodee/web",
    "test:shared": "npm test --workspace @doodee/shared"
  }
}
